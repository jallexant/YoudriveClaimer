# All paths are relative to the directory from which you run the CLI.
YOUDRIVE_DB_PATH=data/youdrive.sqlite3
YOUDRIVE_DAILY_CLAIM_LIMIT=3
YOUDRIVE_TIMEZONE=Europe/Paris
YOUDRIVE_LOG_LEVEL=INFO
# Contract number used only as the subject and first line of a Gmail draft.
YOUDRIVE_CONTRACT_NUMBER=
# Optional signature. Use \n for a line break. Leave empty to omit it.
YOUDRIVE_MAIL_SIGNATURE=
# Desktop OAuth client JSON from Google Cloud. Stays out of Git.
YOUDRIVE_GMAIL_CLIENT_FILE=
