# All paths are relative to the directory from which you run the CLI.
YOUDRIVE_DB_PATH=data/youdrive.sqlite3
YOUDRIVE_DAILY_CLAIM_LIMIT=3
YOUDRIVE_TIMEZONE=Europe/Paris
YOUDRIVE_LOG_LEVEL=INFO
# Session Android : python -m youdrive login, puis python -m youdrive sync.
