{
  "manifest_version": 3,
  "name": "YouDrive — collecte locale des trajets visibles",
  "version": "0.1.0",
  "description": "Transmet les trajets affichés sur Direct Assurance au serveur local du PC.",
  "host_permissions": ["http://127.0.0.1:8766/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Collecte YouDrive locale"},
  "content_scripts": [{
    "matches": ["https://espace-personnel.direct-assurance.fr/espace-personnel/mypolicy/tableau-de-bord-Youdrive*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
